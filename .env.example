# Load these variables into the backend shell; .env is not loaded automatically.
# Local inference is the default unless LLM_PROVIDER is set.
OLLAMA_MODEL=gemma4:e4b

# Required for live SEC data. Replace with your real contact email.
# SEC_USER_AGENT='FinancialResearchAgent your-contact-email'

# Hosted free model (keep API keys on the backend only)
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=your_key_here
# Leave LLM_PROVIDER=ollama to use the local model.
